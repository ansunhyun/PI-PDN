<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<SIwave_PsiSYZ_Setup>

  <TempWorkingDir>&lt;JobPath&gt;</TempWorkingDir>

  <Distributed>0</Distributed>

  <SimServerName>localhost</SimServerName>

  <SimServerPort>31000</SimServerPort>

  <SimulationPreference>1</SimulationPreference>

  <ModelType>2</ModelType>

  <MinPlaneAreaToMesh>0mm2</MinPlaneAreaToMesh>

  <MinVoidAreaToMesh>0.00118787mm2</MinVoidAreaToMesh>

  <SnapLengthThreshold>2.5um</SnapLengthThreshold>

  <EnhancedBWModeling>0</EnhancedBWModeling>

  <SurfaceRoughnessModel>0</SurfaceRoughnessModel>

  <RMSRoughness>0</RMSRoughness>

  <IgnoreDummyNets>1</IgnoreDummyNets>

  <PerformERC>0</PerformERC>

  <ExcludeNonFunctionalPads>1</ExcludeNonFunctionalPads>

  <AutoNetSelect>1</AutoNetSelect>

  <ImprovedLowFreqResist>0</ImprovedLowFreqResist>

  <SmallHoleSize>-1000mm</SmallHoleSize>

  <SignalNetErrorTol>0</SignalNetErrorTol>

  <ConductorModeling>0</ConductorModeling>

  <ImprovedMetalLoss>0</ImprovedMetalLoss>

  <ImprovedDielectricFill>0</ImprovedDielectricFill>

  <TopFillMaterial>air</TopFillMaterial>

  <BottomFillMaterial>air</BottomFillMaterial>

  <PCBMaterial>air</PCBMaterial>

  <IncludeMetalPlane1>0</IncludeMetalPlane1>

  <IncludeMetalPlane2>0</IncludeMetalPlane2>

  <FloatMetalPlane1>0</FloatMetalPlane1>

  <FloatMetalPlane2>0</FloatMetalPlane2>

  <H1>1mm</H1>

  <H2>1mm</H2>

</SIwave_PsiSYZ_Setup>
